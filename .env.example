NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_APP_URL=

# IANA time zone for server-rendered date/number formatting (default: UTC).
# Keeps SSR output deterministic across regions and silences next-intl's
# ENVIRONMENT_FALLBACK warning.
DEFAULT_TIMEZONE=

# Fallback locale when a request locale cannot be resolved (default: en).
DEFAULT_LOCALE=

PORT=3000 # -public


# Supabase SSR connection (local development defaults are emitted by `supabase status -o env`).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only privileged operations. Never expose this key to browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only Cloudinary upload/deletion configuration.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

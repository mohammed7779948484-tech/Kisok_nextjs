{
  "name": "kisok-admin-next",
  "version": "0.1.0",
  "description": "A Next.js application",
  "keywords": [
    "nextjs",
    "react",
    "typescript",
    "tailwindcss",
    "starter",
    "template",
    "redux"
  ],
  "author": "Teispace",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "NODE_ENV=production next build",
    "start": "next start",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "format:check": "biome format",
    "ci:check": "biome ci",
    "lint-staged": "lint-staged",
    "env:sync": "tsx scripts/sync-env.ts",
    "check:deprecated": "tsx scripts/check-deprecated.ts",
    "check:lean-v2": "python3 scripts/static_validate.py",
    "supabase:types": "python3 scripts/generate_types.py",
    "supabase": "pnpm dlx supabase",
    "verify:lean-v2": "bash scripts/verify-local.sh",
    "seed:local-auth": "tsx scripts/seed-local-auth.ts",
    "type-check": "tsc --noEmit",
    "check": "pnpm type-check",
    "prepare": "husky",
    "commit": "cz",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "validate": "pnpm ci:check && pnpm type-check && pnpm check:deprecated && pnpm check:lean-v2 && pnpm test && pnpm build"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@reduxjs/toolkit": "^2.12.0",
    "@refinedev/core": "^5.0.12",
    "@refinedev/nextjs-router": "^7.0.5",
    "@refinedev/react-hook-form": "^5.0.4",
    "@refinedev/react-table": "^6.0.1",
    "@refinedev/supabase": "^6.0.2",
    "@shadcn/react": "^0.3.0",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "@tanstack/react-query": "^5.102.4",
    "@tanstack/react-table": "^8.21.3",
    "@teispace/env": "^0.2.3",
    "@teispace/next-themes": "^2.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.34.0",
    "next": "^16.2.9",
    "next-intl": "^4.13.0",
    "pino": "^10.3.1",
    "react": "^19.2.7",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.86.0",
    "react-redux": "^9.3.0",
    "react-resizable-panels": "^4.12.3",
    "react-secure-storage": "^1.3.2",
    "recharts": "3.8.0",
    "redux": "^5.0.1",
    "redux-persist": "^6.0.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@tailwindcss/postcss": "^4.3.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.7",
    "pino-pretty": "^13.1.3",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
